##############################################
# Luxlait Planning - Root .env (no secrets)  #
# See README.md > Environment variables      #
##############################################

# ─── Database Configuration ────────────────────────────────────────────────────
# Single source of truth: docker-compose builds DATABASE_URL from these three.
# Postgres only applies POSTGRES_PASSWORD on first start (empty volume). If you
# change the password later without recreating the volume, you get Prisma P1000.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=luxlait_db
# Optional override (local Prisma CLI from host only — use localhost, not "postgres"):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luxlait_db?schema=public

# ─── Application Configuration ────────────────────────────────────────────────
NODE_ENV=development

# Shared secret for the Admin API (must match admin_frontend VITE_ADMIN_SECRET)
ADMIN_SECRET=change_me_admin_secret

# ─── Production Bootstrap (admin account auto creation) ───────────────────────
# These credentials are used by backend/src/scripts/bootstrap.ts on the very
# first container boot to provision the initial admin account. The bootstrap
# is idempotent: once the user exists it will only ensure the role assignment.
# CHANGE THESE VALUES BEFORE DEPLOYING TO A NEW VM.
ADMIN_EMAIL=admin@luxlait.local
ADMIN_PASSWORD=ChangeMe_Luxlait_2026
ADMIN_NAME=Luxlait Administrator

# Set to false to skip the seed and admin bootstrap on container start.
# Useful for restoring from a backup or running a manual seed.
BOOTSTRAP_ON_BOOT=true

# ─── JWT Configuration ────────────────────────────────────────────────────────
# Long, random secret used to sign JWTs (Bearer tokens)
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=8h

# ─── Better Auth Configuration ────────────────────────────────────────────────
# Long, random secret for Better Auth cookie/session encryption
BETTER_AUTH_SECRET=change_me_better_auth_secret

# Public base URL where the backend is reachable (Coolify URL or direct port)
BETTER_AUTH_URL=http://localhost:3000

# Vite dev proxy target when using docker compose (service hostname). Optional on host.
# BACKEND_PROXY_URL=http://backend:3000

# Comma-separated origins allowed for Better Auth (admin app, etc.)
TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080

# ─── OAuth Providers (Optional) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Email Service (SendGrid 2FA) ─────────────────────────────────────────────
# Replace with a real key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Must be a verified sender in your SendGrid account
SENDGRID_FROM_EMAIL=noreply@example.com

# Shared secret between backend and email_service (use a long random string)
EMAIL_SERVICE_SECRET=change_me_email_service_secret

# Port used by the email service container
EMAIL_SERVICE_PORT=3001

# Internal Docker DNS address used by the backend to reach the email service
EMAIL_SERVICE_URL=http://email_service:3001

# Shared secret between backend and solver service
SOLVER_SERVICE_SECRET=change_me_solver_service_secret

# Internal Docker DNS address used by the backend to reach solver service
SOLVER_SERVICE_URL=http://solver_service:8000

