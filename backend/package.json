{
  "name": "luxlait-backend",
  "version": "1.0.0",
  "description": "Luxlait Planning backend API (Express + Prisma + Better Auth)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:planning": "ts-node src/scripts/seed-planning.ts",
    "seed:luxlait": "ts-node src/scripts/seed-luxlait-real.ts",
    "seed:admin": "ts-node src/scripts/seed-admin.ts",
    "seed:bootstrap": "ts-node src/scripts/bootstrap.ts",
    "test:auth": "ts-node src/scripts/test-auth.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.18",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
